# Copie para .env e ajuste. Nunca versione o .env real.

# --- Geral ---
ENVIRONMENT=development
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
APP_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=INFO
WEB_PORT=8080

# --- PostgreSQL ---
POSTGRES_USER=dataflow
POSTGRES_PASSWORD=dataflow
POSTGRES_DB=dataflow
# Para rodar a API fora do Docker (uv run uvicorn ...):
DATABASE_URL=postgresql+psycopg://dataflow:dataflow@localhost:5432/dataflow

# --- Redis (fila do Celery e rate limiting) ---
REDIS_URL=redis://localhost:6379/0
# Somente produção:
REDIS_PASSWORD=

# --- MinIO / S3 ---
MINIO_ROOT_USER=dataflow
MINIO_ROOT_PASSWORD=dataflow-secret
# Imagem mantida pela Chainguard (MinIO Community foi arquivado). Fixe um digest em produção.
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=dataflow
S3_SECRET_KEY=dataflow-secret
S3_BUCKET=dataflow

# --- E-mail (Mailpit em desenvolvimento: http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=DataFlow Analytics <no-reply@dataflow.local>

# --- Limites ---
MAX_CSV_MB=100
MAX_XLSX_MB=25
MAX_UPLOAD_BODY=110MB
PROCESSING_BATCH_ROWS=50000

# --- Worker ---
WORKER_CONCURRENCY=2
WORKER_CPUS=2
WORKER_MEMORY=2g

# --- Produção ---
# Domínio público; o Caddy emite o certificado HTTPS automaticamente.
SITE_ADDRESS=
